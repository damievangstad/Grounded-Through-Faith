# Local development reference for Cloudflare-provided secrets.
# Cloudflare Pages injects these names into Functions as env.VARIABLE.

# Provided as env.OPENAI_API_KEY in the assistant function
OPENAI_API_KEY=

# Provided as env.STRIPE_SECRET_KEY when server-side Stripe access is required
STRIPE_SECRET_KEY=

# Provided as env.STRIPE_PRICE_ID_MONTHLY for recurring membership checkout flows
STRIPE_PRICE_ID_MONTHLY=

# Provided as env.STRIPE_PAYMENT_LINK for direct payment links used by the frontend
STRIPE_PAYMENT_LINK=
