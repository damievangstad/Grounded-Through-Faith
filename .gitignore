# Binary image assets are hosted externally to keep the repository text-only
*.png
*.PNG
*.jpg
*.JPG
*.jpeg
*.JPEG
*.gif
*.GIF
*.webp
*.WEBP
*.bmp
*.BMP
*.ico
*.ICO
*.tif
*.TIF
*.tiff
*.TIFF
# Common design exports that should also live outside of git history
*.psd
*.PSD
*.ai
*.AI
*.heic
*.HEIC
*.raw
*.RAW
*.pdf
*.PDF
*.zip
*.ZIP
*.tar
*.gz
*.tgz
*.7z
*.rar
# If a text-based SVG is needed it can be added explicitly, but binaries are skipped by default
# Explicitly ignored logo asset that deploys outside of the repository
assets/treelogo.png
!assets/.gitkeep

# Node and server artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Environment configuration (real keys stay local)
.env
.env.local
.env.development
.env.production
.env.test
!.env.example
